{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "noImplicitOverride": false,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "types": ["bun"],
    "lib": ["ES2023"]
  },
  "include": ["src", "tests", "tools"]
}
